PORT=3000
PUBLIC_URL=https://your-domain.example
DATA_FILE=./data/leads.json

# Business
COMPANY_NAME=Brightside Painting
CLIENT_TIMEZONE=America/New_York
CLIENT_STATE=GA
SERVICE_ZIPS=30301,30302,30303
BOOKING_LOOKAHEAD_DAYS=7

# Calling policy
ENFORCE_CALL_WINDOW=true
MAX_CALL_ATTEMPTS=3
RETRY_DELAYS_MINUTES=20,1440

# Meta
META_VERIFY_TOKEN=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_VERSION=v26.0
# Only list forms whose disclaimer has been reviewed for automated calls and texts
META_CONSENT_FORM_IDS=

# Website form
WEBSITE_FORM_SECRET=

# Vapi
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
VAPI_WEBHOOK_SECRET=

# Cal.com
CAL_API_KEY=
CAL_USERNAME=
CAL_EVENT_SLUG=painting-estimate

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# Team alerts
SLACK_WEBHOOK_URL=
